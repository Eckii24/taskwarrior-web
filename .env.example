# Example environment configuration for taskwarrior-web
# Copy this file to .env and adjust values for your environment

# Server Configuration
PORT=3000
NODE_ENV=development

# Logging
LOG_LEVEL=info

# CORS Configuration
# Comma-separated list of allowed origins
# Use * to allow all origins (NOT recommended for production)
ALLOWED_ORIGINS=http://localhost:3000

# Taskwarrior Configuration
# Optional: Override default taskwarrior data directory (~/.task)
# TASKDATA=/path/to/custom/.task

# Optional: Override default taskrc path (~/.task/taskrc)
# TASKRC=/path/to/custom/taskrc

# Optional: Override settings database path (~/.task/taskwarrior-web.sqlite)
# SETTINGS_DB=/path/to/custom/settings.db

# Session Secret (REQUIRED in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=your-secret-key-at-least-32-characters-long

# Production Settings
# When NODE_ENV=production:
# - Error messages are sanitized
# - Console logging is disabled
# - SESSION_SECRET is required
# - HTTPS should be enabled (via reverse proxy)
